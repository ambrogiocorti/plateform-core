# Development baseline. Generate RATE_LIMIT_SECRET securely; never commit its value.
ENVIRONMENT=development
RELEASE_VERSION=0.1.0
TELEMETRY_ENABLED=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
RATE_LIMIT_SECRET=
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY are platform-provided.
# Step 6 provider sandbox/production configuration. Never commit real values.
# Keep STRIPE/SATISPAY_API feature flags disabled until the matching sandbox gate passes.
PUBLIC_BASE_URL=https://staging.ristorante.example
PAYMENTS_VENUE_ID=
PAYMENTS_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SATISPAY_API_BASE_URL=https://staging.authservices.satispay.com
SATISPAY_KEY_ID=
SATISPAY_PRIVATE_KEY_PKCS8=
SATISPAY_CALLBACK_TOKEN=
# Multi-venue installs may override provider values with _<VENUE_UUID_WITHOUT_HYPHENS_UPPERCASE>.
# Print and offline signing secrets are configured in their roadmap steps.

# Supabase hosted gateway. Use x-forwarded-for only behind an explicitly verified proxy.
TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
# CORE is the default. FULL requires the matching frontend build and database licences.
PLATEFORM_EDITION=CORE

# Guest deposit return: a public booking URL, without query, fragment or access token.
DEPOSIT_RETURN_URL=https://staging.ristorante.example/prenota
# Scheduled worker secrets; leave empty until the matching Vault/cron configuration exists.
MESSAGE_WORKER_TOKEN=
MESSAGE_DELIVERY_MODE=
NO_SHOW_DEPOSIT_WORKER_TOKEN=
# Archive encryption/key custody must match the operational continuity configuration.
AUDIT_ARCHIVE_KEY_ID=
AUDIT_ARCHIVE_ENCRYPTION_KEY=
AUDIT_ARCHIVE_PREVIOUS_KEYS=
# Configure only in an isolated non-production environment.
DATABASE_CHAOS_PROBE_TOKEN=
