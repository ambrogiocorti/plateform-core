# Development baseline. Generate RATE_LIMIT_SECRET securely; never commit its value.
ENVIRONMENT=development
RELEASE_VERSION=0.1.0
TELEMETRY_ENABLED=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
RATE_LIMIT_SECRET=
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY are platform-provided.
# Step 6 provider sandbox/production configuration. Never commit real values.
# Keep STRIPE/SATISPAY_API feature flags disabled until the matching sandbox gate passes.
PUBLIC_BASE_URL=https://staging.ristorante.example
PAYMENTS_VENUE_ID=
PAYMENTS_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SATISPAY_API_BASE_URL=https://staging.authservices.satispay.com
SATISPAY_KEY_ID=
SATISPAY_PRIVATE_KEY_PKCS8=
SATISPAY_CALLBACK_TOKEN=
# Multi-venue installs may override provider values with _<VENUE_UUID_WITHOUT_HYPHENS_UPPERCASE>.
# reservation-deposit (large-group booking deposit): https URL of the public booking page the
# guest returns to after Stripe/Satispay (?sede=<slug>&deposito=<id> is appended). It reuses the
# provider keys above (per venue), STRIPE_WEBHOOK_SECRET for checkout.session.* events and
# SATISPAY_CALLBACK_TOKEN for the deposit callback.
DEPOSIT_RETURN_URL=https://staging.ristorante.example/prenota
# Print and offline signing secrets are configured in their roadmap steps.

# Supabase hosted gateway. Use x-forwarded-for only behind an explicitly verified proxy.
TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip

# Scheduled workers (pg_net). Each token must equal the Vault secret named on its right;
# generate 64 hex characters, set both together and rotate both together.
MESSAGE_WORKER_TOKEN=            # Vault: plateform_message_worker_token
NO_SHOW_DEPOSIT_WORKER_TOKEN=    # Vault: plateform_no_show_deposit_worker_token
DATABASE_CHAOS_PROBE_TOKEN=      # Vault: plateform_database_chaos_probe_token
# continuity-retention-worker and audit-archive-* verify the continuity worker token in the DB.

# reservation-message-worker (required): dry_run (no provider call; MOCK jobs SENT) or live.
# Unset makes every call answer SERVICE_UNAVAILABLE without claiming anything.
MESSAGE_DELIVERY_MODE=dry_run
MESSAGE_TIME_ZONE=Europe/Rome
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
RESEND_API_KEY=
RESEND_FROM=
TELEGRAM_BOT_TOKEN=

# audit-archive-worker / audit-archive-verify: AES-256-GCM key (32 bytes, base64).
AUDIT_ARCHIVE_KEY_ID=
AUDIT_ARCHIVE_ENCRYPTION_KEY=
AUDIT_ARCHIVE_PREVIOUS_KEYS=     # optional id=base64,... for rotated keys
AUDIT_ARCHIVE_PRIMARY_BUCKET=plateform-continuity-audit-archive
AUDIT_ARCHIVE_REPLICA_BUCKET=plateform-continuity-audit-archive-replica
AUDIT_ARCHIVE_REPLICA_SUPABASE_URL=       # optional: replica in a separate project
AUDIT_ARCHIVE_REPLICA_SERVICE_ROLE_KEY=
