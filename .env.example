# Never use a production project during development.
VITE_ENVIRONMENT=development
VITE_PUBLIC_BASE_URL=http://localhost:5173
VITE_STAFF_BASE_URL=http://localhost:5174
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_RELEASE_VERSION=0.1.0
# Exact HTTPS origins, comma-separated; no credentials, paths, or wildcards.
VITE_IMAGE_ORIGINS=
VITE_CONNECT_ORIGINS=
# Public verification keys only; never include the private coordinate d.
VITE_OFFLINE_PUBLIC_KEYS_JWK=[]
# Server-only values belong in Supabase secrets, never VITE_*:
# Server-only Supabase Edge secrets include provider keys; see supabase/secrets.env.example.
# Never expose STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, SATISPAY_PRIVATE_KEY_PKCS8,
# SATISPAY_CALLBACK_TOKEN or SUPABASE_SERVICE_ROLE_KEY through VITE_* variables.
# OFFLINE_SIGNING_PRIVATE_JWK is configured only in the offline roadmap step.
# PRINT_SIGNING_PRIVATE_JWK: server-only ECDSA P-256 signing key for the print bridge
# RETENTION_WORKER_SECRET: server-only random 64 hexadecimal characters for scheduled maintenance
