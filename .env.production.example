VITE_ENVIRONMENT=production
VITE_PUBLIC_BASE_URL=https://ristorante.example
# Server-side release build only; must match get_public_page_metadata canonical origin.
PUBLIC_SITE_ORIGIN=https://ristorante.example
VITE_STAFF_BASE_URL=https://ristorante.example/staff
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_RELEASE_VERSION=0.1.0
VITE_IMAGE_ORIGINS=
VITE_CONNECT_ORIGINS=
VITE_OFFLINE_PUBLIC_KEYS_JWK=[]
# Step 12 backup worker (server-only; never expose in browser builds)
SUPABASE_DB_URL=
PLATEFORM_BACKUP_ROOT=/srv/plateform-backups
PLATEFORM_BACKUP_ENCRYPTION_KEY_BASE64=
PLATEFORM_BACKUP_ENCRYPTION_KEY_ID=
PLATEFORM_BACKUP_LEASE_SECONDS=1800
SUPABASE_CLI_BIN=supabase
# Step 12 isolated restore-test target (server-only; target must be disposable)
PLATEFORM_RESTORE_TEST_SUPABASE_URL=
PLATEFORM_RESTORE_TEST_SERVICE_ROLE_KEY=
PLATEFORM_RESTORE_TEST_DB_URL=
PLATEFORM_RESTORE_TEST_ALLOW_DESTRUCTIVE=false
PLATEFORM_RESTORE_TEST_LEASE_SECONDS=1800
PSQL_BIN=psql

