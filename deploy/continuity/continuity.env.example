# Copy to ~/.config/plateform/continuity.env and chmod 600.
# NEVER commit real values.

# Source Supabase project (control plane + Storage API).
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Usa sb_secret_... (preferito) oppure la legacy service_role; mai anon/publishable.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_SERVER_SECRET

# Direct/session-pooler PostgreSQL connection string used by backup tooling.
SUPABASE_DB_URL=postgresql://REPLACE_WITH_SESSION_OR_DIRECT_CONNECTION

# Persistent encrypted backup root. Must survive host/application replacement.
PLATEFORM_BACKUP_ROOT=/home/plateform/.local/share/plateform/backups
# Required second encrypted copy. Production should use a distinct filesystem/device or remote mount.
PLATEFORM_BACKUP_REPLICA_ROOT=/mnt/plateform-backup-replica
# Development-only escape hatch. Keep false in production.
PLATEFORM_ALLOW_SAME_DEVICE_REPLICA=false
PLATEFORM_BACKUP_ENCRYPTION_KEY_BASE64=REPLACE_WITH_BASE64_32_BYTE_KEY
PLATEFORM_BACKUP_ENCRYPTION_KEY_ID=continuity-key-v1

# Optional historical keys used only for restoring backups created before key rotation.
# Keep this in the secret store, not in the repository.
# PLATEFORM_BACKUP_KEYRING_JSON='{"continuity-key-v0":"BASE64_32_BYTE_OLD_KEY"}'

# Tool paths. Keep explicit on production hosts when multiple versions exist.
SUPABASE_CLI_BIN=supabase
PSQL_BIN=psql
DOCKER_BIN=docker
PLATEFORM_ALLOW_ROOTFUL_DOCKER=false

# Lease for one backup attempt (60-1800 seconds).
PLATEFORM_BACKUP_LEASE_SECONDS=1800

# Lease for one retention purge attempt (60-1800 seconds).
PLATEFORM_RETENTION_LEASE_SECONDS=300

# Optional when using rootless Docker/Podman through a Docker-compatible socket.
# DOCKER_HOST=unix:///run/user/1000/docker.sock

# Restore-test settings are intentionally NOT enabled in the shared worker env.
# Supply them only for an explicit isolated restore-test invocation:
# PLATEFORM_RESTORE_TEST_SUPABASE_URL=https://DISPOSABLE_REF.supabase.co
# PLATEFORM_RESTORE_TEST_SERVICE_ROLE_KEY=REPLACE_DISPOSABLE_SERVER_SECRET
# PLATEFORM_RESTORE_TEST_DB_URL=postgresql://REPLACE_DISPOSABLE_DB_URL
# PLATEFORM_RESTORE_TEST_CONFIRM_PROJECT_REF=DISPOSABLE_REF
# PLATEFORM_RESTORE_TEST_ALLOW_DESTRUCTIVE=true
# PLATEFORM_RESTORE_TEST_LEASE_SECONDS=1800

# Real restore settings are intentionally NOT enabled in the shared worker env.
# Supply them only during an approved replacement-project restore:
# PLATEFORM_RESTORE_TARGET_SUPABASE_URL=https://REPLACEMENT_REF.supabase.co
# PLATEFORM_RESTORE_TARGET_SERVICE_ROLE_KEY=REPLACE_REPLACEMENT_SERVER_SECRET
# PLATEFORM_RESTORE_TARGET_DB_URL=postgresql://REPLACE_REPLACEMENT_DB_URL
# PLATEFORM_RESTORE_TARGET_CONFIRM_PROJECT_REF=REPLACEMENT_REF
# PLATEFORM_RESTORE_ALLOW_DESTRUCTIVE=true
# PLATEFORM_RESTORE_LEASE_SECONDS=1800
