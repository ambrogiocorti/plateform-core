{
  "name": "plateform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev:public": "vite --config vite.public.config.ts",
    "dev:staff": "vite --config vite.staff.config.ts",
    "build": "npm run typecheck && vite build --config vite.public.config.ts && vite build --config vite.staff.config.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/database",
    "test:e2e": "playwright test",
    "check:edge": "node scripts/run-edge.mjs check",
    "test:edge": "node scripts/run-edge.mjs test",
    "check": "npm run check:migrations && npm run check:waiter-ux && npm run check:step11 && npm run typecheck && npm run lint && npm run check:edge && npm run test:edge && npm test && npm run build",
    "requirements": "node scripts/check-requirements.mjs",
    "build:pages": "npm run build && node scripts/build-site.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:zip": "node scripts/package-release.mjs",
    "print:bridge": "node tools/print-bridge/start.ts",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:runtime": "node scripts/check-runtime-configuration.mjs",
    "check:edge-http": "node scripts/check-edge-http.mjs",
    "check:gateway": "node scripts/check-gateway-rate-limit.mjs",
    "check:providers": "node scripts/check-provider-sandbox-config.mjs all",
    "setup:satispay:sandbox": "node scripts/setup-satispay-sandbox.mjs",
    "backup:check": "node tools/backup-worker/start.mjs --check",
    "backup:once": "node tools/backup-worker/start.mjs --once",
    "check:backup-worker": "node scripts/check-backup-worker.mjs",
    "restore-test:check": "node tools/restore-test-worker/start.mjs --check",
    "restore-test:once": "node tools/restore-test-worker/start.mjs --once",
    "check:restore-test-worker": "node scripts/check-restore-test-worker.mjs",
    "check:continuity-alerting": "node scripts/check-continuity-alerting.mjs",
    "check:continuity-targets": "node scripts/check-continuity-targets.mjs",
    "restore:check": "node tools/restore-worker/start.mjs --check",
    "restore:once": "node tools/restore-worker/start.mjs --once",
    "check:restore-worker": "node scripts/check-restore-worker.mjs",
    "check:restore-cutover": "node scripts/check-restore-cutover.mjs",
    "continuity:host-check": "node scripts/check-continuity-host.mjs",
    "check:continuity-contract": "node scripts/check-continuity-contract.mjs",
    "check:continuity-binding": "node scripts/check-continuity-project-binding.mjs",
    "check:migration-history-recovery": "node scripts/check-migration-history-recovery.mjs",
    "check:storage-metadata": "node scripts/check-storage-metadata-integrity.mjs",
    "retention:check": "node tools/backup-retention-worker/start.mjs --check",
    "retention:once": "node tools/backup-retention-worker/start.mjs --once",
    "check:retention-worker": "node scripts/check-backup-retention-worker.mjs",
    "check:retention-ui": "node scripts/check-retention-ui.mjs",
    "check:backup-keyring": "node scripts/check-backup-keyring.mjs",
    "check:backup-filesystem": "node scripts/check-backup-filesystem-safety.mjs",
    "check:snapshot-consistency": "node scripts/check-backup-snapshot-consistency.mjs",
    "check:backup-commit": "node scripts/check-backup-commit-reconciliation.mjs",
    "check:backup-replica": "node scripts/check-backup-replica.mjs",
    "check:manifest-auth": "node scripts/check-backup-manifest-auth.mjs",
    "check:operational-release": "node scripts/check-operational-release-metadata.mjs",
    "check:private-recovery": "node scripts/check-private-recovery-policy.mjs",
    "check:continuity-server-key": "node scripts/check-continuity-server-key.mjs",
    "check:continuity-installer": "node scripts/check-continuity-installer.mjs",
    "check:continuity-bootstrap": "node scripts/check-continuity-bootstrap.mjs",
    "check:continuity-activation": "node scripts/check-continuity-activation.mjs",
    "check:step12": "node scripts/check-step12-static.mjs",
    "check:continuity-secret-config": "node scripts/check-continuity-secret-config.mjs",
    "check:step11": "npm run check:step11-static && npm run check:step11-runtime && npm run check:step11-booking && npm run check:step11-prerender && npm run check:step11-build-assembly && npm run check:step11-assets && npm run check:step11-deploy-config",
    "check:step8": "npm run check:step8-static && node --experimental-strip-types scripts/check-step8-vault.mjs && node --experimental-strip-types scripts/check-step8-causality.mjs && node --experimental-strip-types scripts/check-step8-reconnect.mjs && node --experimental-strip-types scripts/check-step8-pwa.mjs",
    "check:step7": "node --experimental-strip-types scripts/check-step7-returns.mjs",
    "check:step10-cross-venue": "node --experimental-strip-types scripts/check-step10-cross-venue.mjs",
    "check:step9-room-editor": "node --experimental-strip-types scripts/check-step9-room-editor.mjs",
    "local:preflight": "node scripts/local-release-preflight.mjs",
    "local:source-gates": "npm run check:migrations && npm run check:waiter-ux && npm run check:kitchen-pass-ux && npm run check:host-ux && npm run check:cashier-ux && npm run check:kitchen-admin-ux && npm run check:admin-ux && npm run check:super-admin-ux && npm run check:step7 && npm run check:step8 && npm run check:step9-room-editor && npm run check:step9-advanced && npm run check:step10-cross-venue && npm run check:step10-ux && npm run check:step11 && npm run check:step12 && npm run typecheck && npm run lint && npm run format:check",
    "local:verify": "npm run local:preflight && npm run local:source-gates && npm run check:edge && npm run test:edge && npm test && npm run build",
    "local:browser": "npm run test:e2e",
    "local:full": "npm run local:verify && npm run local:browser",
    "check:step11-runtime": "node --experimental-strip-types scripts/check-step11-public-runtime.mjs && node --experimental-strip-types scripts/check-step11-telemetry-observers.mjs",
    "check:step11-static": "node scripts/check-step11-static.mjs",
    "check:step11-assets": "node --experimental-strip-types scripts/check-step11-assets.mjs",
    "local:package": "npm run local:source-gates && node scripts/package-local-rc.mjs",
    "local:windows:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-local-windows.ps1",
    "local:windows:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-windows.ps1",
    "check:step8-static": "node scripts/check-step8-static.mjs",
    "check:waiter-ux": "node --experimental-strip-types scripts/check-waiter-service-ux.mjs",
    "check:kitchen-pass-ux": "node scripts/check-kitchen-pass-ux.mjs",
    "check:host-ux": "node scripts/check-host-ux.mjs",
    "check:cashier-ux": "node scripts/check-cashier-ux.mjs",
    "check:kitchen-admin-ux": "node scripts/check-kitchen-admin-ux.mjs",
    "check:admin-ux": "node scripts/check-admin-ux.mjs",
    "check:super-admin-ux": "node scripts/check-super-admin-ux.mjs",
    "check:step10-ux": "node scripts/check-step10-multivenue-ux.mjs",
    "check:step9-advanced": "node scripts/check-step9-advanced-ux.mjs",
    "check:step7-pdf-browser": "python scripts/check-step7-pdf-browser.py",
    "check:runbook-reconciliation": "node scripts/check-runbook-post-restore-reconciliation.mjs",
    "check:step12-rehearsal": "node scripts/check-step12-real-rehearsal.mjs",
    "continuity:rehearsal": "node scripts/run-step12-real-rehearsal.mjs",
    "finalize:step12": "node scripts/finalize-step12.mjs",
    "check:step11-booking": "node --experimental-strip-types scripts/check-step11-booking-client.mjs",
    "check:step11-prerender": "node scripts/check-step11-prerender.mjs",
    "check:step11-build-assembly": "node scripts/check-step11-build-assembly.mjs",
    "check:step11-deploy-config": "node scripts/check-vercel-config.mjs && node scripts/check-migration-recovery.mjs && npm run check:staging-http-fixtures",
    "reconcile:migrations": "node scripts/reconcile-migrations.mjs --dry-run",
    "reconcile:migrations:write": "node scripts/reconcile-migrations.mjs --write",
    "check:staging-http": "node scripts/verify-staging-http.mjs",
    "check:staging-http-fixtures": "node scripts/check-staging-http.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "idb": "8.0.3",
    "qrcode": "1.5.4",
    "saxes": "6.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@types/qrcode": "1.5.6",
    "deno": "2.9.6",
    "eslint": "10.10.0",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
